# Copy to .env and fill real values. NEVER commit .env.

# PostgreSQL
POSTGRES_USER=hotel
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=hotel_wifi

# RADIUS client source IP: the address OPNsense uses toward this host.
# Self-hosted OPNsense -> its interface IP (private is fine), e.g. 192.168.1.1/32.
# Behind another NAT -> the NAT address. QEMU user-mode lab -> 10.0.2.0/24.
# Confirm the exact value from the log: "from unknown client <IP>".
OPNSENSE_RADIUS_CIDR=192.168.1.1/32

# Shared secret. Printable ASCII without | & \ and no newlines.
RADIUS_SHARED_SECRET=change-me-long-random-string

# Admin console
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-pass
# 0.0.0.0 = reachable from the hotel network. Restrict TCP 8080 at the host
# firewall to the staff subnet. Use 127.0.0.1 only when a TLS proxy is in front.
ADMIN_BIND=0.0.0.0
ADMIN_PORT=8080
# true only when the browser URL is https (TLS proxy in front).
ADMIN_SECURE_COOKIES=false
ADMIN_TRUST_PROXY=false
# Container image tag (default: latest)
IMAGE_TAG=latest
HOTEL_TIMEZONE=Africa/Algiers

# Host ports for RADIUS (UDP)
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
